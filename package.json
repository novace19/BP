{
  "name": "fitness-bp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Rezervační systém fitness centra – bakalářský prototyp",
  "engines": { "node": ">=24.11 <25" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "admin": "node --env-file-if-exists=.env scripts/admin.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "test": "node --test test/*.test.js",
    "check": "node --check src/server.js && node --check src/service.js && node --check public/app.js"
  }
}
